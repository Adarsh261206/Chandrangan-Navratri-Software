# Security: the uploads folder may only serve static image files.
# PHP (or any script handler) must never execute here.

Options -Indexes -ExecCGI -FollowSymLinks

<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php5.c>
  php_flag engine off
</IfModule>

RemoveHandler .php .phtml .pht .phar .php3 .php4 .php5 .php7 .php8 .phps
RemoveType .php .phtml .pht .phar

<FilesMatch "\.(php|phtml|pht|phar|php\d|phps|cgi|pl|py|sh|shtml)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(webp|png|jpe?g|gif|avif)$">
  Require all granted
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

<Files ".htaccess">
  Require all denied
</Files>
